# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# 环境变量
.env

# ============================================================
# 数据目录 — 运行时数据仅存于 test 分支
# ============================================================
data/raw/
data/scored/
data/rated/
data/exports/
data/sync/
data/potential_companies/

# 进度/状态文件
data/*_progress.json
data/.llm_progress.json

# 运行时产出 (仅保留 individual.csv 跟踪)
data/reports/*
!data/reports/individual.csv

# 数据文件
data/*.db
data/wuhan_it_*.csv
data/companies.csv
data/rnd_staff.csv
data/strategy_plan.csv
data/transformation_*.csv

# Scrapy
crawler/jobs/
crawler/.scrapy

# 测试/覆盖率
.pytest_cache/
.coverage

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# 临时文件
*.log
*.tmp

# ============================================================
# Dashboard 运行时 (仅保留程序文件)
# ============================================================
dashboard/__pycache__/
dashboard/*.pid
dashboard/api_check.json
dashboard/out_raw.txt
dashboard/未命名文件

# 日志目录 (test-only)
logs/

# 浏览器登录会话 (含cookies, 勿提交)
.browser-session/
